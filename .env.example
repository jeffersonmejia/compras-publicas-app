# Aplicación
NODE_ENV=development
APP_PORT=3000

# Base de datos
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compras_publicas
DB_USER=postgres
DB_PASSWORD=CAMBIA_ESTA_CLAVE
DB_SCHEMA=public
DB_SSL=false
DB_CONNECTION_LIMIT=10
# Alternativa: usa una única URL de conexión si tu backend la requiere.
DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/compras_publicas?schema=public

# Autenticación y sesión
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO
JWT_ISSUER=compras-publicas-app
JWT_AUDIENCE=compras-publicas-app
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_IN=8h
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_ACTIVE_DURATION_MINUTES=480
