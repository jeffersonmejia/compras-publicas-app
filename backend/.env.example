# Configuración de MySQL para desarrollo local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=compras_publicas
DB_USER=root
DB_PASSWORD=

# Credenciales de Nextcloud (no incluir valores reales en este archivo)
NEXTCLOUD_USERNAME=usuario@ejemplo.com
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_BASE_URL=https://nextcloud.ejemplo.com

# Sesión JWT
JWT_SECRET=replace_with_a_long_random_secret
SESSION_DURATION_MINUTES=120
